{
 "id": "/crossteam-collabhub-pwa",
 "name": "CrossTeam CollabHub \u2014 SCADA & Engineering Project Hub",
 "short_name": "CollabHub",
 "description": "Cross-functional SCADA project collaboration hub",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone",
  "minimal-ui"
 ],
 "start_url": "./index.html?source=pwa",
 "scope": "./",
 "prefer_related_applications": false,
 "theme_color": "#0f172a",
 "background_color": "#090d16",
 "launch_handler": {
  "client_mode": [
   "navigate-existing",
   "auto"
  ]
 },
 "shortcuts": [
  {
   "name": "New Milestone",
   "url": "./index.html?action=milestone",
   "icons": [
    {
     "src": "icons/icon-96.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Upload Engineering Asset",
   "url": "./index.html?action=upload",
   "icons": [
    {
     "src": "icons/icon-96.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Log PM Blocker",
   "url": "./index.html?action=blocker",
   "icons": [
    {
     "src": "icons/icon-96.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "QA/HSE Audit",
   "url": "./index.html?action=qa",
   "icons": [
    {
     "src": "icons/icon-96.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  }
 ],
 "share_target": {
  "action": "./index.html?share-target=1",
  "method": "GET",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url"
  }
 },
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "text/csv": [
     ".csv"
    ],
    "application/json": [
     ".json"
    ],
    "text/plain": [
     ".sql",
     ".txt"
    ]
   }
  }
 ],
 "protocol_handlers": [
  {
   "protocol": "web+collabhub",
   "url": "./index.html?uri=%s"
  }
 ],
 "icons": [
  {
   "src": "icons/icon-72.png",
   "sizes": "72x72",
   "type": "image/png"
  },
  {
   "src": "icons/icon-96.png",
   "sizes": "96x96",
   "type": "image/png"
  },
  {
   "src": "icons/icon-128.png",
   "sizes": "128x128",
   "type": "image/png"
  },
  {
   "src": "icons/icon-144.png",
   "sizes": "144x144",
   "type": "image/png"
  },
  {
   "src": "icons/icon-152.png",
   "sizes": "152x152",
   "type": "image/png"
  },
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/icon-384.png",
   "sizes": "384x384",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/icon-maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "screenshots": [
  {
   "src": "screenshots/screenshot-wide.png",
   "sizes": "1280x720",
   "type": "image/png",
   "form_factor": "wide"
  },
  {
   "src": "screenshots/screenshot-narrow.png",
   "sizes": "540x960",
   "type": "image/png",
   "form_factor": "narrow"
  }
 ]
}